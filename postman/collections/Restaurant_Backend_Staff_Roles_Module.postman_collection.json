{
  "info": {
    "_postman_id": "7d97edaa-stf-47f9-bb29-5f1967395232",
    "name": "Restaurant Backend — Staff & Roles Module",
    "description": "Production Postman test collection for Hestiia Restaurant Staff & Roles Module. Exclusively for Admin Dashboard. Covers all five backend services: Create Staff, Get All Staff, Get Staff by ID, Update Staff, and Soft Delete (Deactivate) Staff with robust security, role validation, duplicate key prevention, and pagination metadata.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Admin Login (Obtain Bearer JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const jsonData = pm.response.json();",
                  "pm.test(\"JWT token received\", function () {",
                  "    pm.expect(jsonData.token).to.be.a(\"string\");",
                  "    pm.environment.set(\"adminToken\", jsonData.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Authenticates restaurant administrator to obtain JWT Bearer Token for subsequent Staff operations."
          }
        }
      ]
    },
    {
      "name": "Service 1: Create Staff",
      "item": [
        {
          "name": "Create Staff Member (Success 201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const res = pm.response.json();",
                  "pm.test(\"Success flag is true and role is staff\", function () {",
                  "    pm.expect(res.success).to.be.true;",
                  "    pm.expect(res.data.role).to.eql(\"staff\");",
                  "    pm.expect(res.data.isActive).to.be.true;",
                  "    pm.expect(res.data._id).to.be.a(\"string\");",
                  "    pm.environment.set(\"staffId\", res.data._id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rahul Sharma\",\n  \"phone\": \"9876543210\",\n  \"email\": \"rahul@gmail.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/staff",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "staff"]
            },
            "description": "Registers a new staff employee. Role is strictly assigned to 'staff' and isActive defaults to true."
          }
        },
