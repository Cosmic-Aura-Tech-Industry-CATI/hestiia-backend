                  "    pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json.data && json.data._id) {",
                  "    pm.environment.set(\"percentOfferId\", json.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"20% Chef Special Discount\",\n  \"description\": \"Get 20% off up to ₹150 on orders above ₹500\",\n  \"discountType\": \"percentage\",\n  \"discountValue\": 20,\n  \"maxDiscount\": 150,\n  \"minOrderValue\": 500,\n  \"startDate\": \"2026-01-01T00:00:00.000Z\",\n  \"endDate\": \"2026-12-31T23:59:59.000Z\",\n  \"placements\": [\"home\"],\n  \"displayPriority\": 5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/offers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "offers"]
            }
          }
        },
        {
