    {
      "name": "3. Customer Cart & Offer Application",
      "item": [
        {
          "name": "Add Item to Cart",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data._id) {",
                  "    pm.environment.set(\"cartId\", json.data._id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-guest-id",
                "value": "{{guestId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dishId\": \"507f1f77bcf86cd799439021\",\n  \"name\": \"Butter Chicken\",\n  \"price\": 350,\n  \"quantity\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/customer/cart/items",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customer", "cart", "items"]
            }
          }
        },
        {
          "name": "Customer Service 5: Apply Offer to Cart",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-guest-id",
                "value": "{{guestId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cartId\": \"{{cartId}}\",\n  \"offerId\": \"{{percentOfferId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/customer/cart/apply-offer",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customer", "cart", "apply-offer"]
            }
