          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/offers?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "offers"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
