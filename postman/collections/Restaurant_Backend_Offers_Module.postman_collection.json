              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isActive\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/offers/{{offerId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "offers", "{{offerId}}", "status"]
            }
          }
        },
        {
          "name": "Service 7: Get Offer Analytics",
          "request": {
            "method": "GET",
            "header": [
