            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/gallery/sections",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "gallery", "sections"]
            }
          }
        },
        {
          "name": "Get Admin Gallery Sections",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/gallery/sections",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "gallery", "sections"]
            }
          }
        },
        {
          "name": "Delete Section",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/gallery/sections/{{sectionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "gallery", "sections", "{{sectionId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Admin - Moderation",
      "item": [
        {
          "name": "List Customer Submissions for Moderation",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/gallery/customer-uploads?moderationStatus=pending",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "gallery", "customer-uploads"],
              "query": [
                {
                  "key": "moderationStatus",
                  "value": "pending"
                }
              ]
            }
          }
        },
        {
          "name": "Moderate Customer Photo (Approve / Reject)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"action\": \"approved\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/gallery/customer-uploads/{{photoId}}/moderate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "gallery", "customer-uploads", "{{photoId}}", "moderate"]
            }
          }
        }
      ]
    }
  ]
}
