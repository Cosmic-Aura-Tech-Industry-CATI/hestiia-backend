# HESTIIA RESTAURANT — BACKEND ENVIRONMENT CONFIGURATION
# Copy to .env for local development

PORT=5000
NODE_ENV=development

# Database Configuration
# MongoDB connection URI (fallback to local in-memory/JSON store if unreachable)
MONGODB_URI=mongodb://localhost:27017/hestiia_restaurant

# Authentication & Security
JWT_SECRET=dimisi_hestiia_super_secure_jwt_secret_2026
JWT_EXPIRES_IN=7d

# Regional & Operational Settings
APP_TIMEZONE=Asia/Kolkata

# Allowed Client Origins for CORS
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Cloudinary Image Processing (Optional - falls back to local uploads if unset)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Or full URL: CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# Email / Gmail SMTP Configuration (For 2FA Login OTP & Password Reset)
# If using Gmail, use a 16-character Google App Password (not your personal password)
# Learn more: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
GMAIL_USER=
GMAIL_APP_PASS=
EMAIL_FROM=


