PORT=5000
NODE_ENV=development

# MongoDB Connection (Required)
MONGODB_URI=mongodb://localhost:27017/hestiia_restaurant

# JWT Authentication (Must be >= 32 characters in production)
JWT_SECRET=replace_with_a_strong_32_plus_char_secret_key
JWT_EXPIRES_IN=7d

# CORS / Frontend URLs
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Cloudinary Media Storage (Required for /api/admin/upload)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=hestiia

APP_TIMEZONE=Asia/Kolkata
